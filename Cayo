<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Calculateur de Butin - Cayo Perico</title>
    <style>
        :root {
            --bg-color: #121212;
            --card-bg: #1e1e1e;
            --accent-color: #2ecc71;
            --text-color: #ffffff;
            --text-secondary: #aaaaaa;
            --border-color: #333333;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
        }

        .container {
            max-width: 600px;
            width: 100%;
            background: var(--card-bg);
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.5);
            border: 1px solid var(--border-color);
        }

        h1 {
            text-align: center;
            color: var(--accent-color);
            margin-bottom: 5px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .subtitle {
            text-align: center;
            color: var(--text-secondary);
            font-size: 0.9rem;
            margin-bottom: 25px;
        }

        .section {
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 1px solid var(--border-color);
        }

        label {
            display: block;
            font-weight: bold;
            margin-bottom: 8px;
        }

        select, input[type="number"] {
            width: 100%;
            padding: 10px;
            background: #2a2a2a;
            border: 1px solid var(--border-color);
            color: white;
            border-radius: 6px;
            box-sizing: border-box;
            font-size: 1rem;
        }

        .loot-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
        }

        .loot-item {
            background: #252525;
            padding: 10px;
            border-radius: 6px;
            border: 1px solid var(--border-color);
        }

        .checkbox-container {
            display: flex;
            align-items: center;
            gap: 10px;
            cursor: pointer;
            margin-top: 15px;
        }

        button {
            width: 100%;
            padding: 14px;
            background: var(--accent-color);
            border: none;
            color: #121212;
            font-size: 1.1rem;
            font-weight: bold;
            border-radius: 6px;
            cursor: pointer;
            transition: background 0.2s;
            text-transform: uppercase;
        }

        button:hover {
            background: #27ae60;
        }

        .results {
            margin-top: 25px;
            background: #151515;
            padding: 20px;
            border-radius: 8px;
            border-left: 5px solid var(--accent-color);
            display: none;
        }

        .results h2 {
            margin-top: 0;
            font-size: 1.3rem;
            color: var(--accent-color);
        }

        .result-row {
            display: flex;
            justify-content: space-between;
            margin: 8px 0;
            font-size: 1rem;
        }

        .total-row {
            border-top: 1px solid var(--border-color);
            padding-top: 10px;
            margin-top: 10px;
            font-weight: bold;
            font-size: 1.2rem;
            color: var(--accent-color);
        }
    </style>
</head>
<body>

<div class="container">
    <h1>Cayo Perico Calculator</h1>
    <div class="subtitle">Optimisation du butin secondaire</div>

    <!-- Étape 1 : Joueurs -->
    <div class="section">
        <label for="players">Nombre de joueurs :</label>
        <select id="players" onchange="verifierOr()">
            <option value="1">1 Joueur (Solo - Sacs: 100%)</option>
            <option value="2">2 Joueurs (Sacs: 200%)</option>
            <option value="3">3 Joueurs (Sacs: 300%)</option>
            <option value="4">4 Joueurs (Sacs: 400%)</option>
        </select>
    </div>

    <!-- Étape 2 : Loots -->
    <div class="section">
        <label>Piles de loots repérées :</label>
        <div class="loot-grid">
            <div class="loot-item">
                <label for="loot-Or">🏆 Or :</label>
                <input type="number" id="loot-Or" min="0" value="0">
            </div>
            <div class="loot-item">
                <label for="loot-Cocaine">🥈 Cocaïne :</label>
                <input type="number" id="loot-Cocaine" min="0" value="0">
            </div>
            <div class="loot-item">
                <label for="loot-Herbe">🥉 Herbe :</label>
                <input type="number" id="loot-Herbe" min="0" value="0">
            </div>
            <div class="loot-item">
                <label for="loot-Tableau">🖼️ Tableau :</label>
                <input type="number" id="loot-Tableau" min="0" value="0">
            </div>
            <div class="loot-item" style="grid-column: span 2;">
                <label for="loot-Cash">💵 Argent Liquide :</label>
                <input type="number" id="loot-Cash" min="0" value="0">
            </div>
        </div>

        <label class="checkbox-container">
            <input type="checkbox" id="rubio-safe" checked>
            Vider le coffre fort d'El Rubio (+75 000 $ moyen)
        </label>
    </div>

    <button onclick="calculerButin()">Calculer la Route Optimale</button>

    <!-- Étape 3 : Résultats -->
    <div id="results-box" class="results">
        <h2>📋 Plan de Récolte Optimal</h2>
        <div class="result-row">
            <span>Espace total utilisé :</span>
            <span id="res-sac" style="font-weight: bold;">0%</span>
        </div>
        
        <div id="res-composition" style="margin: 15px 0; padding-left: 10px; border-left: 2px solid #555;">
            <!-- Rempli par le script -->
        </div>

        <div class="result-row">
            <span>Butin des sacs (Brut) :</span>
            <span id="res-brut-sec">0 $</span>
        </div>
        <div class="result-row">
            <span>Coffre d'El Rubio :</span>
            <span id="res-rubio">0 $</span>
        </div>
        <div class="result-row" style="color: #e74c3c;">
            <span>Frais Pavel & Clôture (12%) :</span>
            <span id="res-frais">0 $</span>
        </div>
        <div class="result-row total-row">
            <span>GAIN NET SECONDAIRE :</span>
            <span id="res-net">0 $</span>
        </div>
    </div>
</div>

<script>
    const LOOT_DATA = {
        "Or":       { valeur: 332000, poids: 66.7, multi: true },
        "Cocaine":  { valeur: 220000, poids: 50.0, multi: false },
        "Herbe":    { valeur: 147000, poids: 37.5, multi: false },
        "Tableau":  { valeur: 185000, poids: 50.0, multi: false },
        "Cash":     { valeur: 85000,  poids: 25.0, multi: false }
    };

    function verifierOr() {
        const nbJoueurs = parseInt(document.getElementById("players").value);
        const inputOr = document.getElementById("loot-Or");
        if (nbJoueurs === 1) {
            inputOr.value = 0;
            inputOr.disabled = true;
            inputOr.parentElement.style.opacity = "0.4";
        } else {
            inputOr.disabled = false;
            inputOr.parentElement.style.opacity = "1";
        }
    }

    function calculerButin() {
        const nbJoueurs = parseInt(document.getElementById("players").value);
        const capaciteTotale = nbJoueurs * 100;
        const viderRubio = document.getElementById("rubio-safe").checked;

        let listeItems = [];

        // Récupération des données saisies
        for (const [nom, info] of Object.entries(LOOT_DATA)) {
            const qte = parseInt(document.getElementById(`loot-${nom}`).value) || 0;
            
            if (info.multi && nbJoueurs < 2) continue; // Skip l'or en solo

            for (let i = 0; i < qte; i++) {
                listeItems.push({
                    nom: nom,
                    poids: info.poids,
                    valeur: info.valeur,
                    ratio: info.valeur / info.poids
                });
            }
        }

        // Tri par rentabilité (Ratio décroissant)
        listeItems.sort((a, b) => b.ratio - a.ratio);

        let sacActuel = 0;
        let valeurBruteSecondaire = 0;
        let composition = {};

        // Remplissage algorithmique du sac
        for (const item of listeItems) {
            if (sacActuel + item.poids <= capaciteTotale) {
                sacActuel += item.poids;
                valeurBruteSecondaire += item.valeur;
                composition[item.nom] = (composition[item.nom] || 0) + 1;
            } else if (sacActuel < capaciteTotale) {
                let placeRestante = capaciteTotale - sacActuel;
                let fraction = placeRestante / item.poids;
                valeurBruteSecondaire += item.valeur * fraction;
                sacActuel = capaciteTotale;
                composition[item.nom] = (composition[item.nom] || 0) + parseFloat(fraction.toFixed(2));
                break;
            }
        }

        // Économie et frais
        const bonusCoffre = viderRubio ? 75000 : 0;
        const totalBrut = valeurBruteSecondaire + bonusCoffre;
        const frais = totalBrut * 0.12; // 2% Pavel + 10% Fencing Fee
        const totalNet = totalBrut - frais;

        // Affichage des résultats dans le HTML
        document.getElementById("res-sac").innerText = `${sacActuel.toFixed(1)}% / ${capaciteTotale}%`;
        document.getElementById("res-brut-sec").innerText = `${Math.round(valeurBruteSecondaire).toLocaleString()} $`;
        document.getElementById("res-rubio").innerText = `${bonusCoffre.toLocaleString()} $`;
        document.getElementById("res-frais").innerText = `-${Math.round(frais).toLocaleString()} $`;
        document.getElementById("res-net").innerText = `${Math.round(totalNet).toLocaleString()} $`;

        // Composition visuelle
        const compoBox = document.getElementById("res-composition");
        compoBox.innerHTML = "<strong>À ramasser :</strong><br>";
        if (Object.keys(composition).length === 0) {
            compoBox.innerHTML += "Rien. Tu n'as renseigné aucun loot disponible !";
        } else {
            for (const [loot, qte] of Object.entries(composition)) {
                compoBox.innerHTML += `• ${qte} pile(s) de <strong>${loot}</strong><br>`;
            }
        }

        document.getElementById("results-box").style.display = "block";
    }

    // Initialisation au chargement
    verifierOr();
</script>
</body>
</html>
